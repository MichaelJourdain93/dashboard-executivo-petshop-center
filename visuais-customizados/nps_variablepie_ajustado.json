{
  "chart": {
    "type": "variablepie"
  },
  "title": {
    "text": "NPS: Volume vs. Qualidade"
  },

  "series": [
    {
      "minPointSize": 10,
      "innerSize": "20%",
      "zMin": 0,
      "name": "NPS",
      "data": [
        "map",
        ["getColumn", 0, 1, 2],
        {
          "name": ["get", ["item"], 0],
          "y": ["get", ["item"], 1],
          "z": ["get", ["item"], 2],
          "color": [
            "case",
            ["==", ["get", ["item"], 0], "Promotor"], "#28a745",
            ["==", ["get", ["item"], 0], "Detrator"], "#dc3545",
            "#ffc107"
          ]
        }
      ]
    }
  ],
   "tooltip": {
    "headerFormat": "",
    "pointFormat": "<span style='color:{point.color}'>\u25CF</span> <b> {point.name}</b><br/>Respostas: <b>{point.y}</b><br/>Nota Média: <b>{point.z}</b><br/>"
  }
}